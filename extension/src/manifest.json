{
  "manifest_version": 3,
  "name": "PromptForge",
  "version": "0.1.0",
  "description": "Prompt-AI-powered drafting assistant for text-generation platforms (§20.2)",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://qsfu5lcqt2.execute-api.us-east-1.amazonaws.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://www.midjourney.com/*",
    "https://stability.ai/*",
    "https://chat.mistral.ai/*",
    "https://huggingface.co/chat/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Open the PromptForge overlay"
    },
    "enhance-selection": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Enhance the selected text with PromptForge"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chatgpt.com/g/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://www.midjourney.com/*",
        "https://stability.ai/*",
        "https://chat.mistral.ai/*",
        "https://huggingface.co/chat/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
