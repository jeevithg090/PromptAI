# PromptForge backend — required secrets (all stubbed; copy to .env and fill in)
# NOTE: .env is gitignored. Never commit real values. Production secrets live in
# AWS SSM Parameter Store (SecureString), not in files. (spec §23.2, §32.3)

# --- Supabase (consumer project) — created in task T1.2 ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# One of the two below is required for JWT verification (JWKS preferred):
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# --- Default model provider (spec §9.1-9.3) — Groq, OpenAI-compatible, no-card free tier ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Alternate provider — Cerebras, faster but 8192-token context cap on free tier ---
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- Alternate provider — OpenCode Zen gateway (was the original default) ---
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Embeddings provider for the PKB (spec §6) — Google Gemini free tier ---
GEMINI_API_KEY=

# --- Cloudflare (Path B: R2 for encrypted blobs/media, KV for registry edge cache) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_KV_NAMESPACE_ID=

# --- Behavior config (config over code, spec §32.3) ---
LOG_LEVEL=info
MAX_TOKENS_PER_SESSION=10000
CONTENT_SAFETY_ENABLED=true
CLARIFY_MAX_QUESTIONS=4
CRITIC_MAX_REFINEMENTS=2
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# --- Local dev only ---
PORT=3001
# Set to "true" ONLY for local development without Supabase credentials.
# Bypasses JWT verification with a fixed dev user. Refused when NODE_ENV=production.
DEV_AUTH_BYPASS=false

# --- Optional overrides ---
# Absolute path to platform-registry.json (defaults to <repo>/config/platform-registry.json)
PLATFORM_REGISTRY_PATH=
# Absolute path to model-routing.json (defaults to <repo>/config/model-routing.json)
MODEL_ROUTING_PATH=
