{
  "name": "pf-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PromptForge orchestration backend — single Lambdalith (Hono router), internally modular per spec §32.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "migrate": "node dist/scripts/migrate.js",
    "seed:registry": "node dist/scripts/seed-registry.js",
    "seed:pkb": "npm run build && node dist/scripts/seed-pkb.js",
    "seed:grounding": "npm run build && node dist/scripts/seed-pkb-grounding.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "smoke:intent": "npm run build && node dist/scripts/smoke-intent.js",
    "crawl:pkb": "npm run build && node dist/scripts/crawl-pkb.js",
    "retention": "npm run build && node dist/scripts/retention-sweep.js",
    "analyze:outcomes": "npm run build && node dist/scripts/improvement-analysis.js",
    "refresh:models": "npm run build && node dist/scripts/refresh-model-capabilities.js"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1084.0",
    "@hono/node-server": "^1.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.0",
    "jose": "^4.15.9",
    "pg": "^8.22.0",
    "pino": "^9.4.0",
    "stripe": "^22.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
