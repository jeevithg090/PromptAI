{
  "name": "promptai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome lint --error-on-warnings --diagnostic-level=warn",
    "deps": "depcruise apps packages --config .dependency-cruiser.cjs && node packages/gates/src/licences.ts",
    "knip": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm deps && pnpm knip && pnpm test",
    "gates:g1": "node packages/gates/src/g1.ts",
    "gates:gp": "pnpm --filter @promptai/gates gp",
    "gates:axe": "pnpm --filter @promptai/gates axe",
    "bundle:keys": "node packages/bundle/src/cli.ts keys",
    "bundle:build": "node packages/bundle/src/cli.ts build",
    "bundle:sign": "node packages/bundle/src/cli.ts sign"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "dependency-cruiser": "18.7.2",
    "knip": "6.45.1"
  }
}
