# Web app (Next.js static export). Copy to .env.local for local development.
# All values are public: they are inlined into the browser bundle at build time.

# Backend API base URL (defaults to http://localhost:3001 when unset).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase project used for sign-in. Leave both empty to run without auth UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the deployed site, used for absolute Open Graph/Twitter image
# URLs (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
